{
  "name": "ember-mcp-server",
  "version": "0.1.0",
  "description": "Lean task tracker for agent-driven team development, exposed only via MCP and a small REST API",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ember-server": "dist/index.js",
    "ember-admin": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "dev": "tsx --disable-warning=ExperimentalWarning watch src/index.ts",
    "admin": "node --disable-warning=ExperimentalWarning dist/cli.js",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.13.7",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
