# Where to listen. Keep 127.0.0.1 unless the port is protected by a VPN / reverse proxy.
EMBER_HOST=127.0.0.1
EMBER_PORT=8787

# SQLite file (directory is created on start).
EMBER_DB_PATH=./data/ember.db

# Extra Host header values to accept when exposed beyond loopback (DNS-rebinding protection).
# Example: EMBER_ALLOWED_HOSTS=ember.internal,ember.tailnet-name.ts.net
EMBER_ALLOWED_HOSTS=

# Lean WIP limits.
EMBER_MAX_CLAIMS_PER_ACTOR=3
EMBER_CLAIM_TTL_MINUTES=90
EMBER_MAX_CLAIM_TTL_MINUTES=1440
# Optional per-status limits, e.g. "analysis=4,in_progress=6"
EMBER_WIP_LIMITS=

# Max request body in bytes.
EMBER_BODY_LIMIT_BYTES=1048576
